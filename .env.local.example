# Supabase — copiar a .env.local y completar con los datos del proyecto
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Opcional — acceso demo automático: si entrás sin sesión a una ruta
# protegida (/dashboard, /recursos, etc.), loguea con esta cuenta y sigue
# directo, sin pasar por /login. Requiere un usuario real ya creado y
# confirmado en Supabase Auth (ver README, sección "Acceso demo").
# DEMO_LOGIN_EMAIL=demo@ingnala.com
# DEMO_LOGIN_PASSWORD=una-contraseña-cualquiera

# Opcional — auth en stand-by: saca el gate de login por completo, ninguna
# ruta pide sesión. SOLO desarrollo/preview, nunca con datos reales de la
# empresa (ver README, sección "Auth en stand-by").
# DISABLE_AUTH=true

# Necesaria para que las páginas muestren datos reales mientras
# DISABLE_AUTH=true (sin sesión, las políticas RLS bloquean casi todo).
# Se consigue en Supabase: Project Settings → API → service_role key.
# Nunca exponer esta key al navegador ni commitearla.
# SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
