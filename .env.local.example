# Supabase — copiar a .env.local y completar con los datos del proyecto
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Opcional — botón "Ver el sistema (acceso demo)" en /login.
# Solo aparece si están las dos variables seteadas. Requiere un usuario real
# ya creado y confirmado en Supabase Auth (ver README, sección "Acceso demo").
# DEMO_LOGIN_EMAIL=demo@ingnala.com
# DEMO_LOGIN_PASSWORD=una-contraseña-cualquiera
